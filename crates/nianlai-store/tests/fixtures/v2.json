      "kind": "table",
      "name": "formats",
      "table": "formats",
      "sql": "CREATE TABLE formats (\n                content_id INTEGER NOT NULL REFERENCES contents(id) ON DELETE CASCADE,\n                name TEXT NOT NULL, fingerprint BLOB NOT NULL CHECK(length(fingerprint)=32),\n                bytes INTEGER NOT NULL CHECK(bytes>=0), encoding INTEGER NOT NULL CHECK(encoding IN (0,1)),\n                data BLOB NOT NULL, PRIMARY KEY(content_id,name))"
